{{!
    @template block_uteluqchatbot/chatbot_main

    Main chatbot interface.

    Context variables:
    * isteacher (bool)
    * coursename (string)

    @copyright 2025 Université TÉLUQ and the UNIVERSITÉ GASTON BERGER DE SAINT-LOUIS
}}
<div class="block_uteluqchatbot">
    <div class="chatbot-wrap">

        {{! ── Header ── }}
        <div class="chatbot-header">
            <div class="chatbot-header-left">
                <div class="chatbot-avatar" aria-hidden="true">
                    <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="20" cy="20" r="20" fill="url(#hg)"/>
                        <path d="M13 16a7 7 0 0 1 14 0v3a7 7 0 0 1-14 0v-3z" fill="white" opacity=".9"/>
                        <path d="M16 24.5c0 2.2 1.8 4 4 4s4-1.8 4-4" stroke="white" stroke-width="1.5" stroke-linecap="round" fill="none"/>
                        <defs>
                            <linearGradient id="hg" x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#6366f1"/>
                                <stop offset="1" stop-color="#8b5cf6"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
                <div class="chatbot-header-info">
                    <span class="chatbot-name">UGB Chatbot</span>
                    {{#coursename}}
                    <span class="chatbot-course">{{coursename}}</span>
                    {{/coursename}}
                </div>
            </div>
            <div class="chatbot-header-right">
                <span class="chatbot-status-dot" title="{{#str}}online, block_uteluqchatbot{{/str}}"></span>
            </div>
        </div>

        {{! ── Messages ── }}
        <div id="chat-messages" class="chatbot-messages" role="log" aria-live="polite" aria-label="{{#str}}chat_history, block_uteluqchatbot{{/str}}">
            <div class="chatbot-message bot-msg welcome-msg">
                <div class="msg-avatar" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="12" fill="url(#hg2)"/>
                        <path d="M8 10a4 4 0 0 1 8 0v2a4 4 0 0 1-8 0v-2z" fill="white" opacity=".9"/>
                        <defs>
                            <linearGradient id="hg2" x1="0" y1="0" x2="24" y2="24" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#6366f1"/>
                                <stop offset="1" stop-color="#8b5cf6"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
                <div class="msg-bubble">
                    {{#isteacher}}
                    {{#str}}hello_professor, block_uteluqchatbot{{/str}}
                    {{/isteacher}}
                    {{^isteacher}}
                    {{#str}}hello_student, block_uteluqchatbot{{/str}}
                    {{/isteacher}}
                </div>
            </div>
        </div>

        {{! ── Error zone ── }}
        <div id="error-message" class="chatbot-error" role="alert" aria-live="assertive"></div>

        {{! ── Upload status bar (shown during file indexing) ── }}
        <div class="cb-upload-status" id="cb-upload-status" aria-live="polite">
            <span class="cb-upload-spin"></span>
            <span class="cb-upload-label"></span>
        </div>

        {{! ── Input zone ── }}
        <div class="chatbot-footer">
            <form id="chatform" class="chatbot-form" autocomplete="off">
                <label for="question" class="sr-only">{{#str}}ask_your_question_here, block_uteluqchatbot{{/str}}</label>
                <textarea id="question" name="question" class="chatbot-input"
                          placeholder="{{#str}}ask_your_question_here, block_uteluqchatbot{{/str}}"
                          rows="1" required></textarea>
                <button type="submit" class="chatbot-send" aria-label="{{#str}}send, block_uteluqchatbot{{/str}}">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2 .01 7z" fill="currentColor"/>
                    </svg>
                </button>
            </form>

            {{#isteacher}}
            <div class="chatbot-teacher-bar">
                <button class="chatbot-tool-btn" onclick="togglePromptModal()" type="button">
                    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M13.586 3.586a2 2 0 1 1 2.828 2.828l-.793.793-2.828-2.828.793-.793zm-2.207 2.207L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/>
                    </svg>
                    {{#str}}modify_prompt, block_uteluqchatbot{{/str}}
                </button>
                <button class="chatbot-tool-btn" onclick="toggleFileUploadModal()" type="button">
                    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M3 17a1 1 0 0 1 1-1h12a1 1 0 1 1 0 2H4a1 1 0 0 1-1-1zm3.293-7.707a1 1 0 0 1 1.414 0L9 10.586V3a1 1 0 1 1 2 0v7.586l1.293-1.293a1 1 0 1 1 1.414 1.414l-3 3a1 1 0 0 1-1.414 0l-3-3a1 1 0 0 1 0-1.414z" clip-rule="evenodd"/>
                    </svg>
                    {{#str}}upload_course, block_uteluqchatbot{{/str}}
                </button>
            </div>
            {{/isteacher}}
        </div>

    </div>
</div>
